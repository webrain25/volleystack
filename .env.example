# ==========================================
# VolleyStack - Environment Variables (Budget €0)
# ==========================================

# 1. Neon Serverless PostgreSQL (Free Tier)
# Pooled URL (Port 6543) - used by app runtime
DATABASE_URL="postgresql://<user>:<password>@<ep-pooler-id>.c-8.eu-central-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# Unpooled Direct URL (Port 5432) - used by Prisma migrations and schema push
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<ep-direct-id>.c-8.eu-central-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# 2. Server Configuration
PORT=3000
JWT_SECRET="generate-a-strong-secret-token"
CORS_ORIGIN="http://localhost:5173,https://your-frontend-domain.pages.dev"

# 3. Google Gemini AI (Google AI Studio Free Tier)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-flash"
