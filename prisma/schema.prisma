generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  phone        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  TeamMember[]
}

model Team {
  id        String       @id @default(uuid())
  name      String
  joinCode   String       @unique @default(uuid())
  paypalLink String?
  createdAt  DateTime     @default(now())
  members   TeamMember[]
  events    Event[]
  fineRules FineRule[]
  payments  Payment[]
  announcements Announcement[]
  ledgerTransactions LedgerTransaction[]
}

model TeamMember {
  id         String           @id @default(uuid())
  userId     String
  teamId     String
  isPlayer   Boolean          @default(true)
  shirtNumber Int?
  joinedAt   DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id])
  team       Team             @relation(fields: [teamId], references: [id])
  roles      TeamMemberRole[]
  rsvps      Rsvp[]
  attendance Attendance[]
  fines      Fine[]
  payments   Payment[]
  pastes     Paste[]
  duties     Duty[]
  announcements Announcement[]

  @@unique([userId, teamId])
}

enum Role {
  OWNER
  ADMIN
  CAPTAIN
  VICE_CAPTAIN
  COACH
  ASSISTANT_COACH
  TREASURER
  PLAYER
}

model TeamMemberRole {
  id           String     @id @default(uuid())
  teamMemberId String
  role         Role
  assignedBy   String?
  assignedAt   DateTime   @default(now())
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id])

  @@unique([teamMemberId, role])
}

enum EventType {
  TRAINING
  MATCH
  SOCIAL
}

model Event {
  id         String       @id @default(uuid())
  teamId     String
  title      String
  type       EventType
  date       DateTime
  location   String?
  team       Team         @relation(fields: [teamId], references: [id])
  rsvps      Rsvp[]
  attendance Attendance[]
  duties     Duty[]
}

enum RsvpStatus {
  ATTENDING
  ABSENT
  PENDING
}

model Rsvp {
  id           String     @id @default(uuid())
  eventId      String
  teamMemberId String
  status       RsvpStatus
  updatedAt    DateTime   @updatedAt
  event        Event      @relation(fields: [eventId], references: [id])
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id])

  @@unique([eventId, teamMemberId])
}

model Attendance {
  id           String     @id @default(uuid())
  eventId      String
  teamMemberId String
  isPresent    Boolean    @default(false)
  event        Event      @relation(fields: [eventId], references: [id])
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id])

  @@unique([eventId, teamMemberId])
}

model FineRule {
  id                 String   @id @default(uuid())
  teamId             String
  reason             String
  defaultAmountCents Int
  isActive           Boolean  @default(true)
  team               Team     @relation(fields: [teamId], references: [id])
  fines              Fine[]
}

enum FineStatus {
  UNPAID
  PAID
  VOIDED
}

model Fine {
  id             String              @id @default(uuid())
  teamMemberId   String
  fineRuleId     String
  reasonSnapshot String
  amountCents    Int
  status         FineStatus          @default(UNPAID)
  issuedBy       String?
  issuedAt       DateTime            @default(now())
  teamMember     TeamMember          @relation(fields: [teamMemberId], references: [id])
  fineRule       FineRule            @relation(fields: [fineRuleId], references: [id])
  allocations    PaymentAllocation[]
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Payment {
  id           String              @id @default(uuid())
  teamId       String
  teamMemberId String
  amountCents  Int
  method       PaymentMethod
  status       PaymentStatus       @default(PENDING)
  declaredAt   DateTime            @default(now())
  confirmedAt  DateTime?
  team         Team                @relation(fields: [teamId], references: [id])
  teamMember   TeamMember          @relation(fields: [teamMemberId], references: [id])
  allocations  PaymentAllocation[]
}

model PaymentAllocation {
  id          String   @id @default(uuid())
  paymentId   String
  fineId      String
  amountCents Int
  payment     Payment  @relation(fields: [paymentId], references: [id])
  fine        Fine     @relation(fields: [fineId], references: [id])
}

enum PasteStatus {
  PENDING
  DELIVERED
}

model Paste {
  id           String      @id @default(uuid())
  teamMemberId String
  reason       String
  status       PasteStatus @default(PENDING)
  deadline     DateTime?
  assignedAt   DateTime    @default(now())
  deliveredAt  DateTime?
  teamMember   TeamMember  @relation(fields: [teamMemberId], references: [id])
}

model Announcement {
  id           String     @id @default(uuid())
  teamId       String
  authorId     String
  title        String
  content      String
  createdAt    DateTime   @default(now())
  expiresAt    DateTime?
  team         Team       @relation(fields: [teamId], references: [id])
  author       TeamMember @relation(fields: [authorId], references: [id])
}

model Duty {
  id           String     @id @default(uuid())
  eventId      String
  teamMemberId String
  description  String
  isCompleted  Boolean    @default(false)
  event        Event      @relation(fields: [eventId], references: [id])
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id])
}

enum LedgerTransactionType {
  INCOME
  EXPENSE
}

model LedgerTransaction {
  id          String                @id @default(uuid())
  teamId      String
  type        LedgerTransactionType
  amountCents Int
  description String
  date        DateTime              @default(now())
  team        Team                  @relation(fields: [teamId], references: [id])
}
