# Questo Caddyfile serve sia per il frontend (file statici) che come reverse proxy per l'API Fastify
{
    email tuo@indirizzo.email # TODO: Sostituire con l'email per i certificati Let's Encrypt
}

# TODO: Sostituire localhost con il tuo dominio reale in produzione (es. volleystack.com)
localhost {
    # 1. Inoltra le richieste /api al container Node.js (api:3000)
    handle_path /api/* {
        reverse_proxy api:3000
    }

    # 2. Servi l'applicazione React (SPA)
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
