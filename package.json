    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@prisma/client": "^5.22.0"
  }
