  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @volleystack/web dev",
    "dev:api": "pnpm --filter @volleystack/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
